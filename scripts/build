#!/bin/bash
# build - builds the W client, its test program and the shared reader library.
#
# For a general audience: compiles the project's game client (C on raylib,
# a small library for windows, input and OpenGL drawing) from src/, its
# test program from tests/, and the reader library (libwreaders.so: the
# parts that read the game's files, with no window) that
# world-edit-to-execute loads from Lua. Everything it makes goes to the RAM
# tier (tmp/tmp/build/), as every build product here does. Each build's
# length is printed and appended to tmp/shared-memory/build-times.log.
#
# Claude may run this build while it stays under about five minutes; past
# that, the build goes back to the owner (docs/008-build-system.md).
#
# Usage: scripts/build [PROJECT_DIR] [--test] [--asan] [--tsan]
#   --test   also run the test program after building
#   --asan   also build an address-checked client (w-client-asan, clang): it
#            reports memory read or written after it was freed or past its
#            end, with where; slower, for hunting crashes
#   --tsan   also build a race-checked client (w-client-tsan, clang): it
#            reports two threads using the same memory with no lock between
#            them, with both places; slower

# {{{ set_dir
DIR="/mnt/kaun/custom-client"
if [[ -n "$1" && "$1" != --* ]]; then
    DIR="$1"
    shift
fi
# }}}

set -euo pipefail
START=$(date +%s)
SRC="${DIR}/src"
source /home/ritz/programming/ai-stuff/scripts/libs/ensure-ram-tiers
ensure_ram_tiers "${DIR}" || exit 1
OUT="${DIR}/tmp/tmp/build"
mkdir -p "${OUT}"
[[ -f /usr/local/include/raylib.h && -f /usr/local/lib/libraylib.a ]] || {
    echo "ERROR: Raylib not found in /usr/local (raylib.h, libraylib.a): build and install raylib first"; exit 1; }

CFLAGS=(-std=c11 -D_FILE_OFFSET_BITS=64 -D_POSIX_C_SOURCE=200809L -O2 -g -Wall -Wextra -Werror -I/usr/local/include)

# {{{ the parts, in reading order
# READERS: the game's file formats, no window: the shared library is made of these
READERS=(013-errors 015-mpq 016-dbc 017-blp 049-jpeg 020-adt 021-wmo 022-m2 023-anim 024-particles)
# CORE: every part that needs no window (the readers and the game's arithmetic):
# the test program links these alone
CORE=(014-settings "${READERS[@]}" 018-maps 019-navmesh-slope 025-character 026-light 027-liquid
      028-collide 029-mover 030-moves 031-camera 032-sight 033-ground-prep 034-prefetch 035-creatures 104-wdb)
# DRAWING: the parts that send things to the graphics card
DRAWING=(036-texture 037-sky 038-ground 039-horizon 040-water 041-figure 042-doodads)
sources() { for p in "$@"; do printf '%s\n' "${SRC}/${p}.c"; done; }
mapfile -t CORE_C < <(sources "${CORE[@]}")
mapfile -t DRAWING_C < <(sources "${DRAWING[@]}")
mapfile -t READERS_C < <(sources "${READERS[@]}")
LINK=(/usr/local/lib/libraylib.a -lz -lm -lpthread -ldl -lrt -lX11 -lGL)
# }}}

echo "building the test program"
cc "${CFLAGS[@]}" "${CORE_C[@]}" "${DIR}/tests/044-test-client.c" -lz -lm -lpthread -o "${OUT}/w-client-test"
echo "building the client"
cc "${CFLAGS[@]}" "${CORE_C[@]}" "${DRAWING_C[@]}" "${SRC}/043-main.c" "${LINK[@]}" -o "${OUT}/w-client"
echo "building the dressing room"           # item pictures for pages outside the game (issue 410; scripts/item-pictures)
cc "${CFLAGS[@]}" "${CORE_C[@]}" "${DRAWING_C[@]}" "${SRC}/058-dressing-room.c" "${LINK[@]}" -o "${OUT}/dressing-room"
echo "building the reader library"
cc "${CFLAGS[@]}" -fPIC -shared "${READERS_C[@]}" -lz -lm -lpthread -o "${OUT}/libwreaders.so"
# its header for LuaJIT's ffi.cdef: every reader's declarations, flattened
# by the preprocessor (the system types they use come along; ffi.cdef
# accepts them). Checked: LuaJIT loads the library with it.
{
    echo "/* wreaders.h - written by scripts/build: the reader library's declarations, flattened for ffi.cdef */"
    for r in "${READERS[@]}"; do echo "#include \"${SRC}/${r}.h\""; done
} > "${OUT}/wreaders-all.h"
cc -E -P -I/usr/local/include "${OUT}/wreaders-all.h" | grep -v '^\s*$' > "${OUT}/wreaders.h"
echo "built: ${OUT}/w-client, ${OUT}/w-client-test, ${OUT}/dressing-room, ${OUT}/libwreaders.so (+ wreaders.h)"

SECONDS_TAKEN=$(( $(date +%s) - START ))
LOG="${DIR}/tmp/shared-memory/build-times.log"
echo "$(date '+%Y-%m-%d %H:%M:%S') ${SECONDS_TAKEN}s" >> "${LOG}"
echo "build took ${SECONDS_TAKEN} seconds (log: ${LOG})"
if (( SECONDS_TAKEN > 300 )); then
    echo "WARNING: the build took over five minutes; by the rule in docs/008-build-system.md, builds go back to the owner"
fi

for arg in "$@"; do
    if [[ "${arg}" == "--asan" || "${arg}" == "--tsan" ]]; then
        command -v clang > /dev/null || { echo "ERROR: ${arg} needs clang"; exit 1; }
        kind="${arg#--}"
        flag=$([[ "${kind}" == asan ]] && echo address || echo thread)
        echo "building the ${kind} client"
        clang -std=c11 -D_FILE_OFFSET_BITS=64 -D_POSIX_C_SOURCE=200809L -O1 -g -fsanitize="${flag}" -fno-omit-frame-pointer \
            -I/usr/local/include "${CORE_C[@]}" "${DRAWING_C[@]}" "${SRC}/043-main.c" "${LINK[@]}" -o "${OUT}/w-client-${kind}"
        echo "built: ${OUT}/w-client-${kind}$([[ "${kind}" == asan ]] && echo ' (run it with ASAN_OPTIONS=detect_leaks=0)')"
    fi
done
for arg in "$@"; do
    if [[ "${arg}" == "--test" ]]; then
        "${OUT}/w-client-test" "${DIR}"
    fi
done
