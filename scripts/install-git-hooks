#!/bin/bash
# install-git-hooks - connects this project's git hooks to its checkout.
#
# For a general audience: git can run a program at certain moments, such as
# right after a commit, but only programs in a hidden folder of each
# checkout (.git/hooks/), which git does not keep or share. The project's
# hooks live in scripts/git-hooks/, where they are kept and shared; this
# links each of them into the hidden folder, once per checkout. It refuses
# to replace a hook that is already there and is not one of these links,
# since that hook is someone's own.
#
# Usage: scripts/install-git-hooks [PROJECT_DIR]

DIR="/mnt/mtwo/games/azeroth-core/custom-client"
if [ -n "$1" ]; then
    DIR="$1"
fi

HOOKS="${DIR}/.git/hooks"
if [ ! -d "${HOOKS}" ]; then
    echo "install-git-hooks: ${DIR} has no .git/hooks; is it a git checkout?" >&2
    exit 1
fi

for hook in "${DIR}"/scripts/git-hooks/*; do
    NAME="${hook##*/}"
    TARGET="${HOOKS}/${NAME}"
    if [ -L "${TARGET}" ] && [ "$(readlink "${TARGET}")" = "${hook}" ]; then
        echo "install-git-hooks: ${NAME} already linked"
    elif [ -e "${TARGET}" ] || [ -L "${TARGET}" ]; then
        echo "install-git-hooks: ${TARGET} already exists and is not ours; left alone" >&2
        exit 1
    else
        ln -s "${hook}" "${TARGET}"
        echo "install-git-hooks: linked ${NAME}"
    fi
done
