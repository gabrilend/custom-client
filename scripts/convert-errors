#!/usr/bin/env luajit
-- convert-errors - turns the client's "0 or 1, with a sentence in a buffer"
-- errors into 013-errors.h's codes with their sentence (a WWhy).
--
-- For a general audience: the code arrived from wow-chat-2026 reporting a
-- failure as a sentence written into a character buffer the caller passed
-- in (two arguments: the buffer and its size). The project's rule is a
-- code the caller can act on plus the sentence (docs/001, "Errors"). This
-- rewrites every such place at once, function by function:
--   - a function taking (char *why, int why_len) takes (WWhy *why);
--   - snprintf(why, why_len, "...") becomes w_fail(why, CODE, "..."), the
--     code chosen from the sentence's wording (rules below; each is then
--     reviewed by eye);
--   - inside such a function, "return 1;" and "return -1;" become
--     "return why->code;" (functions where 1 meant "none here", not a
--     failure, are fixed by hand afterwards: the compiler and the tests
--     show where);
--   - a caller's buffer (char why[400]) that it passes to such a function
--     becomes a WWhy; passing it becomes &why; printing it becomes why.text.
-- One-off, for the move (wow-chat-2026 issue 173v); kept for one commit
-- for the record, then retired.
--
-- Usage: scripts/convert-errors [PROJECT_DIR]   (rewrites src/*.c, src/*.h, tests/*.c in place)

local DIR = arg[1] or "/mnt/mtwo/games/azeroth-core/custom-client"

-- {{{ local function read, write, files
local function read(p) local f = assert(io.open(p, "rb")); local s = f:read("*a"); f:close(); return s end
local function write(p, s) local f = assert(io.open(p, "wb")); f:write(s); f:close() end
local function files()
    local list = {}
    local h = io.popen('ls "' .. DIR .. '"/src/*.c "' .. DIR .. '"/src/*.h "' .. DIR .. '"/tests/*.c')
    for p in h:lines() do list[#list + 1] = p end
    h:close()
    return list
end
-- }}}

-- {{{ the code a sentence gets: the first rule whose words appear wins
local CODES = {
    { "W_ERR_IO",          { "can't open", "can't read", "can't write", "could not be written", "writing .- failed", "strerror" } },
    { "W_ERR_GPU",         { "shader" } },
    { "W_ERR_FULL",        { "all in use", "more than 256", "no room" } },
    { "W_ERR_UNSUPPORTED", { "is not read by this reader", "not read by this", "unsupported", "only what" } },
    { "W_ERR_REFUSED",     { "out of its range", "not a resolution", "no setting named", "not SET name", "isn't slot", "refus" } },
    { "W_ERR_NOT_FOUND",   { "in none of", "is in none", "not in the archives", "no map ", "no creature display", "lacks", "no ground", "no file at", "no MPQ archives", "no lights", "nothing to draw", "has no " } },
}
local function code_for(sentence)
    local low = sentence:lower()
    for _, rule in ipairs(CODES) do
        for _, words in ipairs(rule[2]) do
            if low:find(words:lower()) then return rule[1] end
        end
    end
    return "W_ERR_CORRUPT"                       -- the rest describe bytes that don't make sense
end
-- }}}

-- {{{ which functions take a why: every name declared with (char *why, int why_len)
-- (found from each "char *why, int why_len)" back to its list's opening
-- parenthesis, so parameters that are themselves function pointers, with
-- parentheses of their own, don't hide the name)
local CONVERTED = {}
for _, p in ipairs(files()) do
    local s = read(p)
    local i = 1
    while true do
        local at = s:find("char%s*%*why,%s*int why_len%)", i)
        if not at then break end
        local depth = 0
        for k = at - 1, 1, -1 do
            local c = s:sub(k, k)
            if c == ")" then depth = depth + 1
            elseif c == "(" then
                if depth == 0 then
                    local name = s:sub(1, k - 1):match("([%w_]+)%s*$")
                    if name then CONVERTED[name] = true end
                    break
                end
                depth = depth - 1
            end
        end
        i = at + 1
    end
end
-- }}}

-- {{{ local function split_functions: the file's top-level pieces, functions apart
-- Returns a list of { text, is_body }: text between top-level braces is a body.
local function split_functions(s)
    local parts, depth, start, i = {}, 0, 1, 1
    local n = #s
    while i <= n do
        local c = s:sub(i, i)
        if c == '"' or c == "'" then                      -- skip strings and characters
            local q = c; i = i + 1
            while i <= n and s:sub(i, i) ~= q do if s:sub(i, i) == "\\" then i = i + 1 end; i = i + 1 end
        elseif s:sub(i, i + 1) == "/*" then
            local e = s:find("*/", i + 2, true) or n; i = e + 1
        elseif s:sub(i, i + 1) == "//" then
            local e = s:find("\n", i, true) or n; i = e
        elseif c == "{" then
            if depth == 0 then parts[#parts + 1] = { s:sub(start, i), false }; start = i + 1 end
            depth = depth + 1
        elseif c == "}" then
            depth = depth - 1
            if depth == 0 then parts[#parts + 1] = { s:sub(start, i - 1), true }; start = i end
        end
        i = i + 1
    end
    parts[#parts + 1] = { s:sub(start), false }
    return parts
end
-- }}}

-- {{{ local function callee_of: the function whose call's parentheses hold position p
local function callee_of(s, p)
    local depth = 0
    for i = p - 1, 1, -1 do
        local c = s:sub(i, i)
        if c == ")" then depth = depth + 1
        elseif c == "(" then
            if depth == 0 then return s:sub(1, i - 1):match("([%w_]+)%s*$") end
            depth = depth - 1
        elseif c == ";" or c == "{" or c == "}" then return nil end
    end
    return nil
end
-- }}}

-- {{{ local function convert_body: one function's body
-- `ptr`: the function itself takes a why (now WWhy *why)
local function convert_body(b, ptr)
    -- the fills: snprintf(why, why_len, "...", ...) -> w_fail(why, CODE, "...", ...)
    b = b:gsub('snprintf%(why, why_len, ("[^\n]-[^\\]")', function(fmt) return "w_fail(why, " .. code_for(fmt) .. ", " .. fmt end)
    -- passing it on
    b = b:gsub("why, why_len%)", "why)")
    if ptr then
        b = b:gsub("return %-?1;", "return why->code;")
    end
    -- local buffers passed to a converted function: char NAME[N] -> WWhy NAME
    local locals = {}
    for name in b:gmatch("([%w_]+), sizeof %1%)") do
        local at = b:find(name .. ", sizeof " .. name .. ")", 1, true)
        local callee = callee_of(b, at)
        if callee and CONVERTED[callee] then locals[name] = true end
    end
    for name in pairs(locals) do
        -- the declaration: alone, or one of a list
        local alone = "(\n[ \t]*)char " .. name .. "%[[^%]]+%];"
        if b:find(alone) then
            b = b:gsub(alone, "%1WWhy " .. name .. ";", 1)
        else
            b = b:gsub("(\n([ \t]*)char [^;\n]-), " .. name .. "%[[^%]]+%]([^;\n]-;)", "%1%3\n%2WWhy " .. name .. ";", 1)
            b = b:gsub("(\n([ \t]*)char )" .. name .. "%[[^%]]+%], ([^;\n]-;)", "%1%3\n%2WWhy " .. name .. ";", 1)
        end
        b = b:gsub(name .. ", sizeof " .. name .. "%)", "&" .. name .. ")")
    end
    -- every other bare use of a why-variable is its sentence
    local function textify(var, field)
        local out, i = {}, 1
        while true do
            local s, e = b:find("%f[%w_]" .. var .. "%f[^%w_]", i)
            if not s then break end
            out[#out + 1] = b:sub(i, s - 1)
            local before, after = b:sub(s - 1, s - 1), b:sub(e + 1, e + 2)
            local keep = before == "&" or after:sub(1, 1) == "." or after == "->" or after:sub(1, 1) == "["
                or b:sub(s - 7, s - 1) == "w_fail(" or b:sub(s - 7, s - 1) == "sizeof "
                or b:sub(s - 5, s - 1) == "WWhy "
            if not keep then
                local callee = callee_of(b, s)
                local last = b:sub(e + 1):match("^%s*%)")
                if callee and CONVERTED[callee] and last then keep = true end
            end
            out[#out + 1] = keep and var or (var .. field)
            i = e + 1
        end
        out[#out + 1] = b:sub(i)
        b = table.concat(out)
    end
    if ptr then textify("why", "->text") end
    for name in pairs(locals) do textify(name, ".text") end
    return b
end
-- }}}

-- {{{ main
local changed = 0
for _, p in ipairs(files()) do
    local s = read(p)
    local parts = split_functions(s)
    local out = {}
    for k, part in ipairs(parts) do
        local text, is_body = part[1], part[2]
        if is_body then
            local head = parts[k - 1] and parts[k - 1][1] or ""
            local ptr = head:find("char%s*%*why,%s*int why_len%)") ~= nil
            text = convert_body(text, ptr)
        end
        out[#out + 1] = text
    end
    local t = table.concat(out)
    t = t:gsub("char%s*%*why,%s*int why_len%)", "WWhy *why)")
    if t ~= s then
        if not t:find('#include "013%-errors.h"') and t:find("WWhy") and p:match("%.h$") then
            t = t:gsub("(\n#define [%w_]+_H\n)", "%1\n#include \"013-errors.h\"\n", 1)
        elseif not t:find('#include "013%-errors.h"') and t:find("WWhy") then
            -- after the file's first include of its own header, or its first include
            t = t:gsub('(#include "[^"]+"\n)', '%1#include "013-errors.h"\n', 1)
        end
        write(p, t)
        changed = changed + 1
    end
end
local n = 0
for _ in pairs(CONVERTED) do n = n + 1 end
print("convert-errors: " .. changed .. " files rewritten; " .. n .. " functions now take a WWhy")
-- }}}
