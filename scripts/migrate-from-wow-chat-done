#!/usr/bin/env luajit
-- migrate-from-wow-chat - copies wow-chat-2026's custom client into this
-- project's src/ and tests/, each file renamed to its reading-order number.
--
-- For a general audience: the client was first written inside another
-- project (wow-chat-2026, src/custom-client-c/). This copies every part of
-- it here, gives each part the number it takes in this project's reading
-- order (the table below, the same as docs/009-roadmap.md's crosswalk),
-- and rewrites every mention of a part's file name (the lines that pull
-- one part into another, and the comments that point at a file) so the
-- copied code builds here unchanged. Run once for the move (wow-chat-2026
-- issue 173v); kept for the record of how the code arrived.
--
-- Usage: scripts/migrate-from-wow-chat [PROJECT_DIR] [FROM_DIR]
--   PROJECT_DIR default: /mnt/mtwo/games/azeroth-core/custom-client
--   FROM_DIR    default: /mnt/mtwo/games/azeroth-core/wow-chat-2026/src/custom-client-c
-- It refuses to run if any target file already exists (nothing is ever
-- overwritten); delete the copies first to run it again.

local DIR  = arg[1] or "/mnt/mtwo/games/azeroth-core/custom-client"
local FROM = arg[2] or "/mnt/mtwo/games/azeroth-core/wow-chat-2026/src/custom-client-c"

-- {{{ the reading order (docs/009-roadmap.md, "The crosswalk")
-- old name (as in wow-chat-2026), new number, new name; .h/.c/.info.md share it
local ORDER = {
    { "settings",      14, "settings"      },   -- 013 is errors.h: new here, written by hand, not copied
    { "mpq",           15, "mpq"           },
    { "dbc",           16, "dbc"           },
    { "blp",           17, "blp"           },
    { "maps",          18, "maps"          },
    { "navmesh_slope", 19, "navmesh-slope" },
    { "adt",           20, "adt"           },
    { "wmo",           21, "wmo"           },
    { "m2",            22, "m2"            },
    { "anim",          23, "anim"          },
    { "particles",     24, "particles"     },
    { "character",     25, "character"     },
    { "light",         26, "light"         },
    { "liquid",        27, "liquid"        },
    { "collide",       28, "collide"       },
    { "mover",         29, "mover"         },
    { "moves",         30, "moves"         },
    { "camera",        31, "camera"        },
    { "sight",         32, "sight"         },
    { "ground_prep",   33, "ground-prep"   },
    { "prefetch",      34, "prefetch"      },
    { "creatures",     35, "creatures"     },
    { "texture",       36, "texture"       },
    { "sky",           37, "sky"           },
    { "ground",        38, "ground"        },
    { "horizon",       39, "horizon"       },
    { "water",         40, "water"         },
    { "figure",        41, "figure"        },
    { "doodads",       42, "doodads"       },
    { "main",          43, "main"          },
}
local TEST_NUMBER = 44                           -- tests/test_client.c
-- }}}

-- {{{ local function read, write, exists
local function read(path)
    local f = assert(io.open(path, "rb"), "can't read " .. path)
    local s = f:read("*a")
    f:close()
    return s
end
local function exists(path)
    local f = io.open(path, "rb")
    if f then f:close() return true end
    return false
end
local function write(path, s)
    assert(not exists(path), path .. " already exists; nothing is overwritten (delete the copies first)")
    local f = assert(io.open(path, "wb"), "can't write " .. path)
    f:write(s)
    f:close()
end
-- }}}

-- {{{ local function renamed: every file name of a part, old to new
-- "ground_prep.h" -> "033-ground-prep.h"; matched as a whole word, so
-- "ground.h" never matches inside "ground_prep.h" (longest names first)
local NAMES = {}
for _, o in ipairs(ORDER) do
    NAMES[#NAMES + 1] = { old = o[1], new = string.format("%03d-%s", o[2], o[3]) }
end
table.sort(NAMES, function(a, b) return #a.old > #b.old end)
local function renamed(text)
    for _, n in ipairs(NAMES) do
        for _, ext in ipairs({ "h", "c", "info.md" }) do
            local old = n.old .. "." .. ext
            local pattern = "%f[%w_%-]" .. old:gsub("%.", "%%."):gsub("%-", "%%-") .. "%f[^%w_]"
            text = text:gsub(pattern, n.new .. "." .. ext)
        end
    end
    return text
end
-- }}}

-- {{{ main
os.execute('mkdir -p "' .. DIR .. '/src" "' .. DIR .. '/tests"')
local copied = 0
for _, o in ipairs(ORDER) do
    local new = string.format("%03d-%s", o[2], o[3])
    for _, ext in ipairs({ "h", "c", "info.md" }) do
        local from = FROM .. "/" .. o[1] .. "." .. ext
        if exists(from) then
            write(DIR .. "/src/" .. new .. "." .. ext, renamed(read(from)))
            copied = copied + 1
        end
    end
end
-- the test program: its includes reach into ../src/, and the server's data
-- is reached through assets/server-data (a git-ignored link to the
-- extracted maps, vmaps and mmaps of an AzerothCore server)
local test = renamed(read(FROM .. "/tests/test_client.c"))
test = test:gsub('#include "%.%./', '#include "../src/')
test = test:gsub("/data%-files/", "/assets/server-data/")
write(DIR .. string.format("/tests/%03d-test-client.c", TEST_NUMBER), test)
copied = copied + 1
-- the reading-order counter: the highest number now in use
local f = assert(io.open(DIR .. "/.file-index-counter", "w"))
f:write(tostring(TEST_NUMBER) .. "\n")
f:close()
print(string.format("migrate-from-wow-chat: %d files copied into %s/src and tests, numbered %03d to %03d", copied, DIR, 14, TEST_NUMBER))
-- }}}
